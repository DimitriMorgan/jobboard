# Port du serveur HTTP
PORT=3000

# Chemin du fichier SQLite
DB_PATH=./data/jobboard.sqlite

# Lancer une actualisation automatiquement au démarrage (true/false)
REFRESH_ON_START=false
# Actualisation automatique périodique en minutes (0 = désactivé)
AUTO_REFRESH_MINUTES=0

# LinkedIn : budget de requêtes par actualisation (recherche + fiches) et nombre maximal de fiches lues.
LINKEDIN_MAX_REQUESTS=1300
LINKEDIN_DETAIL_LIMIT=1000
# Fenêtre de recherche LinkedIn forcée en heures (vide = depuis la dernière actualisation réussie, entre 24 h et 7 jours)
LINKEDIN_WINDOW_HOURS=
# Fiches détaillées lues par actualisation pour les autres sources (WTTJ, APEC, HelloWork, LesJeudis…)
DETAIL_FETCH_LIMIT=60

# Sources désactivées (identifiants séparés par des virgules), ex: hellowork,hackernews
DISABLED_SOURCES=

# --- Sources optionnelles nécessitant des identifiants (gratuits) ---
# France Travail (ex Pôle emploi) : https://francetravail.io  (API "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble : https://jooble.org/api/about
JOOBLE_API_KEY=

# Welcome to the Jungle (Algolia) : clés publiques embarquées dans le site, à mettre à jour si elles changent
WTTJ_ALGOLIA_APP_ID=CSEKHVMS53
WTTJ_ALGOLIA_API_KEY=4bd8f6215d0cc52b26430765769e65a0
WTTJ_ALGOLIA_INDEX=wttj_jobs_production_fr

# Découverte automatique de posts LinkedIn (optionnel) : l'une des deux clés suffit.
# Tavily : https://tavily.com (gratuit, 1 000 requêtes/mois, sans carte bancaire)
TAVILY_API_KEY=
# SerpApi : https://serpapi.com (offre gratuite limitée)
SERPAPI_KEY=
